# Banco de dados (docker-compose.yml)
DATABASE_URL="postgresql://jobpilot:jobpilot@localhost:5432/jobpilot?schema=public"

# Claude API (Fase 3 — matching com IA)
ANTHROPIC_API_KEY=""

# Auth.js (login). Gere o secret com o comando abaixo e cole o resultado em AUTH_SECRET:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# OAuth App do GitHub: https://github.com/settings/developers
# Homepage URL: http://localhost:3000
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Limite de gasto mensal com IA, em USD
AI_MONTHLY_BUDGET_USD="10"
