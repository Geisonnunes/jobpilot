# Banco de dados (docker-compose.yml)
DATABASE_URL="postgresql://jobpilot:jobpilot@localhost:5432/jobpilot?schema=public"

# IA (Fase 3 — matching). Provedor: "claude-cli" (padrão; usa o Claude Code instalado e a sua
# assinatura, sem custo de API) ou "anthropic-api" (Claude API, cobrada por uso).
AI_PROVIDER="claude-cli"
# Modelo do matching. Vazio = padrão do provedor.
AI_MODEL_MATCH=""
# Caminho do executável do Claude Code. Vazio = "claude" no PATH. Precisa ser um .exe/binário (não .cmd).
CLAUDE_CLI_PATH=""
# Máximo de avaliações por execução de `npm run match`
AI_MAX_EVALUATIONS_PER_RUN="10"
# Só é necessária com AI_PROVIDER="anthropic-api"
ANTHROPIC_API_KEY=""

# Auth.js (login). Gere o secret com o comando abaixo e cole o resultado em AUTH_SECRET:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# OAuth App do GitHub: https://github.com/settings/developers
# Homepage URL: http://localhost:3000
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Limite de gasto mensal com IA, em USD
AI_MONTHLY_BUDGET_USD="10"
